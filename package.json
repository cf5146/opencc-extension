{
  "name": "opencc-extension",
  "version": "1.0.0",
  "description": "Convert webpages between Simplified and Traditional Chinese with one click.",
  "repository": "github:tnychn/opencc-extension",
  "author": {
    "name": "Tony Chan",
    "email": "tnychn@protonmail.com",
    "url": "https://github.com/tnychn"
  },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test": "npm run test:unit",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit && npm run build && npm run build:firefox && npm run build:edge",
    "prepare": "wxt prepare && husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.4",
    "@vitest/coverage-v8": "^4.1.7",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.18.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^4.0.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "svelte": "^5.56.0",
    "svelte-eslint-parser": "^1.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.0.16",
    "wxt": "^0.20.26"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "lint-staged": {
    "*.{ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "opencc-js": "^1.3.1"
  }
}
