{
  "name": "opencc-extension",
  "version": "0.5.11",
  "description": "A browser extension to convert webpages between different Chinese variants.",
  "repository": "github:tnychn/opencc-extension",
  "author": {
    "name": "Tony Chan",
    "email": "tnychn@protonmail.com",
    "url": "https://github.com/tnychn"
  },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "dev:edge": "wxt -b edge --mv3",
    "build": "npm run build:chrome",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:edge": "wxt build -b edge --mv3",
    "zip:chrome": "wxt zip -b chrome --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:edge": "wxt zip -b edge --mv3",
    "dist": "npm run zip:chrome && npm run zip:firefox && npm run zip:edge",
    "postinstall": "wxt prepare",
    "lint": "eslint src entrypoints wxt.config.ts --ext .ts,.js,.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build:chrome && node scripts/verify-build-output.mjs chrome && npm run build:firefox && node scripts/verify-build-output.mjs firefox && npm run build:edge && node scripts/verify-build-output.mjs edge"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@wxt-dev/browser": "^0.2.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  },
  "prettier": {
    "tabWidth": 2,
    "printWidth": 120
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
