{
  "name": "opencc-extension",
  "version": "0.5.10",
  "description": "A browser extension to convert webpages between different Chinese variants.",
  "repository": "github:tnychn/opencc-extension",
  "author": {
    "name": "Tony Chan",
    "email": "tnychn@protonmail.com",
    "url": "https://github.com/tnychn"
  },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "dist": "npm run zip && npm run zip:firefox && npm run zip:edge && node scripts/copy-icons.cjs",
    "lint": "eslint src --ext .ts,.tsx,.js,.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "postinstall": "wxt prepare",
    "ci": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@preact/preset-vite": "^2.10.5",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.10.4",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "jsdom": "^27.4.0",
    "preact": "^10.29.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "wxt": "^0.20.20"
  },
  "prettier": {
    "tabWidth": 2,
    "printWidth": 120
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
