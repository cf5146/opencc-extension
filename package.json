{
  "name": "opencc-extension",
  "version": "0.5.9",
  "description": "A browser extension to convert webpages between different Chinese variants.",
  "repository": "github:tnychn/opencc-extension",
  "author": {
    "name": "Tony Chan",
    "email": "tnychn@protonmail.com",
    "url": "https://github.com/tnychn"
  },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node ./build.mjs",
    "build:watch": "npm run build -- watch",
    "start": "web-ext run -s ./build",
    "start:firefox": "node scripts/dev.mjs firefox",
    "start:chromium": "node scripts/dev.mjs chromium",
    "dist:chrome": "node scripts/dist.mjs chrome",
    "dist:firefox": "node scripts/dist.mjs firefox",
    "dist:edge": "node scripts/dist.mjs edge",
    "dist": "node scripts/dist-all.mjs",
    "lint": "eslint src build.mjs --ext .ts,.js,.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "ci": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "esbuild": "^0.27.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.4.1",
    "typescript": "^5.5.4",
    "vitest": "^4.0.14",
    "web-ext": "^8.3.0"
  },
  "prettier": {
    "tabWidth": 2,
    "printWidth": 120
  },
  "eslintConfig": {
    "env": {
      "es6": true,
      "browser": true,
      "webextensions": true
    },
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "prettier"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
