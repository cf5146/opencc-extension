{
  "manifest_version": 3,
  "name": "OpenCC",
  "author": "Tony Chan",
  "version": "0.5.4",
  "description": "Convert webpages between different Chinese variants.",
  "homepage_url": "https://github.com/tnychn/opencc-extension",
  "icons": {
    "128": "icon.png"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": false
  },
  "action": {
    "default_icon": {
      "128": "icon.png"
    },
    "default_title": "OpenCC",
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
  "storage",
  "contextMenus",
  "scripting",
  "tabs",
  "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
